{
  "schema_id": "stratai.spatial_human_review_protocol@1",
  "contract_version": "1.0.0",
  "protocol_version": "1.0.0",
  "handbook": {
    "version": "1.0.0",
    "relative_path": "HANDBOOK.md",
    "sha256": "b0a10ac2fa62b5f2e11f5bf4259743dcfea85f9a14d34fd294a40b7b45938818"
  },
  "published_at": "2026-09-01T00:00:00Z",
  "scope": {
    "map_agnostic": true,
    "families": ["exposure", "cover", "exit_route"],
    "purpose": "human_review_input_only",
    "excluded_uses": [
      "training",
      "product_support",
      "canonical_materialization",
      "release",
      "corpus_reprocessing",
      "automatic_tactical_classification",
      "recommendation_generation"
    ]
  },
  "roles": {
    "independent_reviewer_count": 2,
    "reviewer_slots": ["reviewer_a", "reviewer_b"],
    "adjudicator_required_on_conflict": true,
    "adjudicator_must_be_distinct": true,
    "identity_policy": "opaque_pseudonym_no_public_identity_in_artifact"
  },
  "review_unit": {
    "id_policy": "sha256_opaque_id_from_versioned_source_join",
    "join_policy": "coordinator_only_exact_package_sample_candidate_annotation_refs",
    "partitions": [
      "objective_geometry",
      "observed_context",
      "human_judgment",
      "adjudication"
    ],
    "initial_state": "pending_review",
    "allowed_states": [
      "pending_review",
      "reviewed",
      "needs_adjudication",
      "adjudicated",
      "rejected",
      "unavailable"
    ]
  },
  "question_sets": [
    {
      "family": "exposure",
      "prompt_id": "spatial-question-01",
      "question": "¿La apertura angular mostrada respalda una exposición tácticamente relevante con el contexto factual disponible?",
      "claim_boundary": "Valora sólo relevancia táctica de la apertura; no infieras enemigo, seguridad, intención, recomendación ni outcome.",
      "options": [
        {"answer_id": "supported", "label": "Respaldada", "requires_reason": true},
        {"answer_id": "not_supported", "label": "No respaldada", "requires_reason": true},
        {"answer_id": "missing_context", "label": "Falta contexto", "requires_reason": true},
        {"answer_id": "not_evaluable", "label": "No evaluable", "requires_reason": true},
        {"answer_id": "abstain", "label": "Abstención", "requires_reason": true}
      ]
    },
    {
      "family": "cover",
      "prompt_id": "spatial-question-02",
      "question": "¿La oclusión volumétrica mostrada respalda cover tácticamente utilizable con el contexto factual disponible?",
      "claim_boundary": "Valora sólo utilidad táctica del cover; no conviertas un probe, NAV, callout o exposure en recomendación.",
      "options": [
        {"answer_id": "supported", "label": "Respaldada", "requires_reason": true},
        {"answer_id": "not_supported", "label": "No respaldada", "requires_reason": true},
        {"answer_id": "missing_context", "label": "Falta contexto", "requires_reason": true},
        {"answer_id": "not_evaluable", "label": "No evaluable", "requires_reason": true},
        {"answer_id": "abstain", "label": "Abstención", "requires_reason": true}
      ]
    },
    {
      "family": "exit_route",
      "prompt_id": "spatial-question-03",
      "question": "¿La conexión dirigida mostrada respalda una salida tácticamente viable con el contexto factual disponible?",
      "claim_boundary": "Valora sólo viabilidad táctica de salida; conectividad y coste NAV no prueban seguridad, calidad ni recomendación.",
      "options": [
        {"answer_id": "supported", "label": "Respaldada", "requires_reason": true},
        {"answer_id": "not_supported", "label": "No respaldada", "requires_reason": true},
        {"answer_id": "missing_context", "label": "Falta contexto", "requires_reason": true},
        {"answer_id": "not_evaluable", "label": "No evaluable", "requires_reason": true},
        {"answer_id": "abstain", "label": "Abstención", "requires_reason": true}
      ]
    }
  ],
  "evidence_policy": {
    "allowed_partitions": ["objective_geometry", "observed_context_up_to_t0"],
    "observed_cutoff": "availability_tick_lte_t0",
    "package_only_context_status": "unavailable",
    "minimum_visible_evidence": {
      "exposure": "origin_sector_bounds_and_supporting_rays",
      "cover": "origin_direction_posture_and_nine_probes",
      "exit_route": "origin_destination_and_objective_connectivity"
    },
    "forbidden_information": [
      "oracle",
      "outcomes",
      "future_after_t0",
      "enemy_hidden_state",
      "voice",
      "intent",
      "subjective_sound",
      "public_identity",
      "steam_id",
      "absolute_path",
      "seed_place_name",
      "other_reviewer_response"
    ]
  },
  "blinding": {
    "reviewer_visible_partition": "reviewer_view_only",
    "hidden_fields": [
      "audit_context",
      "package_paths",
      "package_aliases",
      "support_flags",
      "pending_annotations",
      "seed_place_names",
      "other_reviewer_responses"
    ],
    "ordering_algorithm": "sha256_interleaved_deterministic@1",
    "option_order_policy": "identical_neutral_order_across_families",
    "prior_response_visibility": "none"
  },
  "workflow": {
    "transitions": [
      "pending_review->reviewed",
      "pending_review->needs_adjudication",
      "pending_review->rejected",
      "pending_review->unavailable",
      "reviewed->needs_adjudication",
      "needs_adjudication->adjudicated",
      "needs_adjudication->rejected",
      "needs_adjudication->unavailable"
    ],
    "timestamp_policy": "rfc3339_utc_recorded_at_human_action",
    "response_schema_id": "stratai.spatial_human_review_response@1",
    "adjudication_schema_id": "stratai.spatial_human_review_adjudication@1",
    "support_auto_approval_allowed": false
  },
  "disagreement_policy": {
    "compatible_answers": "same_answer_id_from_two_independent_reviewers",
    "conflict_triggers": [
      "different_answer_ids",
      "materially_incompatible_reason_codes",
      "abstention_prevents_completion",
      "evidence_integrity_dispute"
    ],
    "adjudication_requires_reason": true,
    "adjudication_can_rewrite_geometry": false
  },
  "privacy": {
    "allowed_identity": "opaque_local_reviewer_pseudonym_only",
    "forbidden_identity": [
      "name",
      "email",
      "steam_id",
      "faceit_id",
      "public_handle",
      "contact_detail"
    ],
    "absolute_paths_allowed": false,
    "free_text_policy": "no_names_ids_contact_details_or_external_urls"
  },
  "audit_controls": {
    "schema_validation": "draft_2020_12_fail_closed",
    "hash_validation": "protocol_handbook_package_support_and_visible_evidence_sha256",
    "duplicate_policy": "no_duplicate_review_unit_or_source_join",
    "cross_split_policy": "source_group_never_crosses_review_partitions",
    "completeness_policy": "two_responses_then_agreement_or_adjudication",
    "retained_provenance": [
      "protocol_version",
      "handbook_version",
      "package_schema_id",
      "package_sha256",
      "support_manifest_sha256",
      "source_refs",
      "visible_evidence_sha256",
      "human_action_timestamps"
    ]
  },
  "change_policy": {
    "human_review_rewrites_geometry": false,
    "geometry_change_effect": "invalidate_and_version_all_dependent_reviews",
    "handbook_change_effect": "new_explicit_version",
    "package_promotion_is_separate": true
  },
  "authorization": {
    "review_execution_authorized": false,
    "training_use_authorized": false,
    "product_supported": false,
    "canonical_materialization": false,
    "release_authorized": false,
    "corpus_reprocessing_authorized": false
  }
}

  "required": [
    "contract_version",
    "source_alias",
    "source_sha256",
    "build_identifier",
    "partition",
    "comparison_allowed",
    "training_allowed",
    "product_supported",
    "schema_id",
    "source_observations",
    "states",
    "opportunities",
    "summary"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stratai.economy_entry_identity_links@1",
  "x-stratai-training-authorized": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stratai.support_objective_observations@1",
  "x-stratai-training-authorized": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "contract_version",
    "source_alias",
    "source_sha256",
    "build_identifier",
    "comparison_allowed",
    "training_allowed",
    "product_supported",
    "support_source",
    "capture_contract",
    "observations"
  ],
  "properties": {
    "schema_id": {
      "const": "stratai.support_objective_observations@1"
    },
    "contract_version": {
      "const": "1.0.0-candidate.1"
    },
    "source_alias": {
      "type": "string",
      "pattern": "^demo-[a-f0-9]{20}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "build_identifier": {
      "type": "string",
      "minLength": 1
    },
    "comparison_allowed": {
      "const": false
    },
    "training_allowed": {
      "const": false
    },
    "product_supported": {
      "const": false
    },
    "support_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "capture_contract": {
      "const": "same_support_FrameDone_public_objective_prefix@1"
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "frames"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "frame",
              "tick",
              "instance",
              "epoch",
              "order",
              "kind"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "frame": {
                "type": "integer",
                "minimum": 1
              },
              "tick": {
                "type": "integer"
              },
              "instance": {
                "type": "integer",
                "minimum": 0
              },
              "epoch": {
                "type": "integer",
                "minimum": 0
              },
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "enum": [
                  "round_start",
                  "freeze_end",
                  "bomb_planted",
                  "bomb_defused",
                  "bomb_exploded",
                  "round_end"
                ]
              }
            }
          }
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_sequence",
              "frame",
              "tick",
              "instance",
              "epoch",
              "order",
              "event_sequence",
              "rules",
              "players"
            ],
            "properties": {
              "source_sequence": {
                "type": "integer",
                "minimum": 1
              },
              "frame": {
                "type": "integer",
                "minimum": 1
              },
              "tick": {
                "type": "integer"
              },
              "instance": {
                "type": "integer",
                "minimum": 0
              },
              "epoch": {
                "type": "integer",
                "minimum": 0
              },
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "event_sequence": {
                "type": "integer",
                "minimum": 0
              },
              "rules": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "m_bBombPlanted",
                  "m_bFreezePeriod",
                  "m_bWarmupPeriod",
                  "m_iRoundTime"
                ],
                "properties": {
                  "m_bBombPlanted": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "native_type",
                      "value"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "observed",
                          "absent",
                          "unsupported_type"
                        ]
                      },
                      "native_type": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "value": {
                        "type": [
                          "boolean",
                          "integer",
                          "null"
                        ]
                      }
                    }
                  },
                  "m_bFreezePeriod": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "native_type",
                      "value"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "observed",
                          "absent",
                          "unsupported_type"
                        ]
                      },
                      "native_type": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "value": {
                        "type": [
                          "boolean",
                          "integer",
                          "null"
                        ]
                      }
                    }
                  },
                  "m_bWarmupPeriod": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "native_type",
                      "value"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "observed",
                          "absent",
                          "unsupported_type"
                        ]
                      },
                      "native_type": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "value": {
                        "type": [
                          "boolean",
                          "integer",
                          "null"
                        ]
                      }
                    }
                  },
                  "m_iRoundTime": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "native_type",
                      "value"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "observed",
                          "absent",
                          "unsupported_type"
                        ]
                      },
                      "native_type": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "value": {
                        "type": [
                          "boolean",
                          "integer",
                          "null"
                        ]
                      }
                    }
                  }
                }
              },
              "players": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "actor_alias",
                    "pawn_life",
                    "fields"
                  ],
                  "properties": {
                    "actor_alias": {
                      "type": "string",
                      "pattern": "^support-actor-[a-f0-9]{20}$"
                    },
                    "pawn_life": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^support-pawn-[0-9]{6,}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "fields": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "m_bInBombZone",
                        "m_bIsDefusing",
                        "m_pItemServices.m_bHasDefuser"
                      ],
                      "properties": {
                        "m_bInBombZone": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "status",
                            "native_type",
                            "value"
                          ],
                          "properties": {
                            "status": {
                              "enum": [
                                "observed",
                                "absent",
                                "unsupported_type"
                              ]
                            },
                            "native_type": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "minLength": 1
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "value": {
                              "type": [
                                "boolean",
                                "integer",
                                "null"
                              ]
                            }
                          }
                        },
                        "m_bIsDefusing": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "status",
                            "native_type",
                            "value"
                          ],
                          "properties": {
                            "status": {
                              "enum": [
                                "observed",
                                "absent",
                                "unsupported_type"
                              ]
                            },
                            "native_type": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "minLength": 1
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "value": {
                              "type": [
                                "boolean",
                                "integer",
                                "null"
                              ]
                            }
                          }
                        },
                        "m_pItemServices.m_bHasDefuser": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "status",
                            "native_type",
                            "value"
                          ],
                          "properties": {
                            "status": {
                              "enum": [
                                "observed",
                                "absent",
                                "unsupported_type"
                              ]
                            },
                            "native_type": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "minLength": 1
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "value": {
                              "type": [
                                "boolean",
                                "integer",
                                "null"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

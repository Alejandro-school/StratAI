  "$defs": {
    "scalar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "native_type",
        "declared_type",
        "value"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "absent",
            "unsupported_type",
            "nonfinite"
          ]
        },
        "native_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "declared_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": [
                "number",
                "boolean",
                "null"
              ]
            },
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          ]
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "handle",
        "target_life",
        "class_name"
      ],
      "properties": {
        "status": {
          "enum": [
            "resolved",
            "absent",
            "unsupported_type",
            "invalid_sentinel",
            "entity_unavailable",
            "serial_mismatch",
            "kind_or_life_unavailable",
            "destroyed"
          ]
        },
        "handle": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "target_life": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^support-motion-reference-[0-9]{6}$"
        },
        "class_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  }

                "required": [
                  "self.native_eye_offset",
                  "self.reference_fov_degrees",
                  "self.flash_clear",
                  "self.smoke_clear",
                  "self.visual_contact",
                  "ally.native_eye_offset",
                  "ally.reference_fov_degrees",
                  "ally.flash_clear",
                  "ally.smoke_clear",
                  "ally.visual_contact"
                ],
                "properties": {
                  "self.native_eye_offset": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^(observed|unavailable|not_applicable):[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "self.reference_fov_degrees": {
                    "type": "object",

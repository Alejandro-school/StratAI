                    "type": "integer",
                    "minimum": 0
                  },
                  "smoke_clear": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "visual_contact": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },

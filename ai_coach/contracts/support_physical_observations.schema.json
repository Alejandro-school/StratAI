                                    "status",
                                    "value",
                                    "reason"
                                  ],
                                  "properties": {
                                    "status": {
                                      "enum": [
                                        "observed",
                                        "unavailable"
                                      ]
                                    },
                                    "value": {
                                      "anyOf": [
                                        {
                                          "type": "array",
                                          "items": {
                                            "type": "number"
                                          },
                                          "minItems": 2,
                                          "maxItems": 2
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "reason": {
                                      "anyOf": [
                                        {
                                          "enum": [
                                            "native_fields_absent",
                                            "invalid_native_type",
                                            "nonfinite",
                                            "weapon_identity_unavailable",
                                            "current_weapon_observation_unavailable",
                                            "non_ammunition_weapon",
                                            "native_fields_absent_or_invalid",
                                            "reload_signal_unavailable",
                                            "weapon_handle_reused",
                                            "unknown_weapon_class",

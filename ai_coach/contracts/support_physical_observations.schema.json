                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "reason": {
                                      "anyOf": [
                                        {
                                          "enum": [
                                            "native_fields_absent",
                                            "invalid_native_type",
                                            "nonfinite",

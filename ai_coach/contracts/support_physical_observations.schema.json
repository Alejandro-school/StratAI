                                {
                                  "enum": [
                                    "weapon_reload",
                                    "item_equip",
                                    "weapon_fire",
                                    "clip_update"
                                  ]
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "reload_signal_tick": {
                              "anyOf": [
                                {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                {
                                  "type": "null"
                                }
                              ]

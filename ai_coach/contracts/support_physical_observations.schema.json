                                "ammo_reserve": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "status",
                                    "value",
                                    "reason"
                                  ],
                                  "properties": {
                                    "status": {
                                      "enum": [
                                        "observed",
                                        "unavailable",
                                        "not_applicable"
                                      ]
                                    },
                                    "value": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "minimum": 0
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "reason": {
                                      "anyOf": [
                                        {
                                          "enum": [
                                            "native_fields_absent",
                                            "invalid_native_type",
                                            "nonfinite",
                                            "weapon_identity_unavailable",
                                            "current_weapon_observation_unavailable",
                                            "non_ammunition_weapon",
                                            "native_fields_absent_or_invalid",
                                            "reload_signal_unavailable",
                                            "weapon_handle_reused",
                                            "unknown_weapon_class",
                                            "missing_exact_physical_sample",
                                            "actor_physical_context_unavailable"
                                          ]
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    }
                                  }
                                },
                                "reloading": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "status",
                                    "value",
                                    "reason"
                                  ],
                                  "properties": {

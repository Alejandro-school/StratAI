{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stratai.economy_rule_context_manifest@1",
  "x-stratai-training-authorized": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "contract_version",
    "source_alias",
    "source_sha256",
    "build_identifier",
    "comparison_allowed",
    "training_allowed",
    "product_supported",
    "probe_sha256",
    "source_native",
    "artifact",
    "summary"
  ],
  "properties": {
    "schema_id": {
      "const": "stratai.economy_rule_context_manifest@1"
    },
    "contract_version": {
      "const": "1.0.0-candidate.1"
    },
    "source_alias": {
      "type": "string",
      "pattern": "^demo-[a-f0-9]{20}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "build_identifier": {
      "type": "string",
      "minLength": 1
    },
    "comparison_allowed": {
      "const": false
    },
    "training_allowed": {
      "const": false
    },
    "product_supported": {
      "const": false
    },
    "probe_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "economy_native_sources_manifest.json"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "economy_rule_context.json"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messages",
        "boundaries",
        "sessions"
      ],
      "properties": {
        "messages": {
          "type": "integer",
          "minimum": 0
        },
        "boundaries": {
          "type": "integer",
          "minimum": 0
        },
        "sessions": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

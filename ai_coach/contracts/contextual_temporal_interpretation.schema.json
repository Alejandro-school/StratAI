            "sequence",
            "frame",
            "tick",
            "epoch",
            "instance",
            "round_number",
            "tick_rate",
            "sample_step",
            "phase"
          ],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 0
            },
            "frame": {
              "type": "integer",
              "minimum": 0
            },
            "tick": {
              "type": "integer",
              "minimum": 0
            },
            "epoch": {
              "type": "integer",
              "minimum": 0
            },
            "instance": {
              "type": "integer",
              "minimum": 0
            },

              "actor_alias",
              "exclusion",
              "identity",
              "connected",
              "alive",
              "position",
              "physical",
              "has_c4",
              "sampled_displacement",
              "references"
            ],
            "properties": {
              "actor_alias": {
                "type": "string",
                "pattern": "^support-actor-[0-9a-f]{20}$"
              },
              "exclusion": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "identity": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "side",
                      "pawn_handle",
                      "pawn_life",
                      "identity_status"
                    ],
                    "properties": {
                      "side": {
                        "enum": [
                          "T",
                          "CT"
                        ]
                      },
                      "pawn_handle": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "pawn_life": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "identity_status": {
                        "enum": [
                          "observed",
                          "unavailable",
                          "pawn_reference_unresolved"
                        ]
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "connected": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "alive": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "observed"
                      },
                      "value": {
                        "type": "boolean"
                      },
                      "reason": {
                        "type": "null"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "unavailable",
                          "not_applicable"
                        ]
                      },
                      "value": {
                        "type": "null"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              },
              "position": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "observed"
                      },
                      "value": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "x",
                          "y",
                          "z"
                        ],
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          },
                          "z": {
                            "type": "number"
                          }
                        }
                      },
                      "reason": {
                        "type": "null"
                      }
                    }
                  },
                  {
                    "type": "object",

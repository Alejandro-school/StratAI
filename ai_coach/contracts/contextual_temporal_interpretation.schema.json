                    "availability_frame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "availability_tick": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "epoch": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "instance": {
                      "type": "integer",
                      "minimum": 0
                    },

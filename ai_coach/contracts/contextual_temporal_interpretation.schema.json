              "references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "artifact",
                    "source_sequence",
                    "availability_frame",
                    "availability_tick",
                    "epoch",
                    "instance",
                    "actor_alias"
                  ],
                  "properties": {
                    "artifact": {
                      "enum": [
                        "support_observations.json",
                        "support_physical_observations.json",
                        "support_c4_observations.json"

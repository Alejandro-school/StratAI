{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "configuration",
    "context_id",
    "source_alias",
    "source_sha256",
    "side",
    "cut",
    "interval",
    "status",
    "hypotheses",
    "abstention_reasons",
    "unknowns",
    "alternatives",
    "update",
    "recommendations",
    "comparison_allowed",
    "training_allowed",
    "product_supported",
    "temporal_events",
    "temporal_policy",
    "temporal_state",
    "interpretation_id"
  ],
  "properties": {
    "schema_id": {
      "const": "stratai.contextual_interpretation@2"
    },
    "configuration": {
      "const": "collective_c4_approach@2-temporal-provisional"
    },
    "context_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_alias": {
      "type": "string",
      "pattern": "^demo-[0-9a-f]{20}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "side": {
      "enum": [
        "T",
        "CT"
      ]
    },
    "cut": {
      "$ref": "#/$defs/cut"
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_sequence",
        "end_sequence"
      ],
      "properties": {
        "start_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "end_sequence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "status": {
      "enum": [
        "compatible",
        "ambiguous",
        "abstained"
      ]
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "abstention_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan_id",
          "status",
          "reason"
        ],
        "properties": {
          "plan_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "not_excluded_not_supported"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "previous_interpretation_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "initial",
            "prior_context_unavailable",
            "abstained",
            "maintained",
            "revised"
          ]
        },
        "previous_interpretation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "recommendations": {
      "const": []
    },
    "comparison_allowed": {
      "const": false
    },
    "training_allowed": {
      "const": false
    },
    "product_supported": {
      "const": false
    },
    "temporal_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "reason",
          "signal"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "signal": {
            "anyOf": [
              {
                "$ref": "#/$defs/signal"
              },
              {
                "type": "null"
              }
            ]
          },
          "destination_landmark_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "temporal_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contradiction_motion_seconds",
        "pause_expiry_seconds",
        "parameter_status"
      ],
      "properties": {
        "contradiction_motion_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pause_expiry_seconds": {
          "const": null
        },
        "parameter_status": {
          "const": "provisional_engineering_filter_not_expert_threshold"
        }
      }
    },
    "temporal_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_identifier",
        "map_reference_id",
        "last_sample",
        "active"
      ],
      "properties": {
        "build_identifier": {
          "type": "string",
          "minLength": 1
        },
        "map_reference_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_sample": {
          "$ref": "#/$defs/sample"
        },
        "active": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/active"
          }
        }
      }
    },
    "interpretation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stratai.contextual_interpretation@2",
  "x-stratai-training-authorized": false,
  "$defs": {
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "frame",
        "tick",
        "epoch",
        "instance",
        "round_number",
        "tick_rate",
        "sample_step",
        "phase"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "frame": {
          "type": "integer",
          "minimum": 0
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "instance": {
          "type": "integer",
          "minimum": 0
        },
        "round_number": {
          "type": "integer",
          "minimum": 0
        },
        "tick_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "sample_step": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "enum": [
            "playing",
            "postround"
          ]
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "cut",
        "continuity",

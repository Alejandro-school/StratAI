    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "actor_alias",
        "value",
        "start_sequence",
        "end_sequence",
        "references"
      ],
      "properties": {
        "kind": {
          "enum": [
            "sampled_approach_to_landmark",
            "current_c4_possession",
            "stationary_behind_with_utility_equipped",
            "temporal_possibility_maintained",
            "contradictory_motion"
          ]
        },
        "actor_alias": {
          "type": "string",
          "pattern": "^support-actor-[0-9a-f]{20}$"
        },
        "value": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "start_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "end_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "references": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact",
                "source_sequence",
                "availability_frame",
                "availability_tick",
                "epoch",
                "instance",
                "actor_alias"
              ],
              "properties": {
                "artifact": {
                  "enum": [
                    "support_observations.json",
                    "support_physical_observations.json",
                    "support_c4_observations.json"
                  ]
                },
                "source_sequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "availability_frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "availability_tick": {
                  "type": "integer",
                  "minimum": 0
                },
                "epoch": {
                  "type": "integer",
                  "minimum": 0
                },
                "instance": {
                  "type": "integer",
                  "minimum": 0
                },
                "actor_alias": {
                  "type": "string",
                  "pattern": "^support-actor-[0-9a-f]{20}$"
                }
              }
            }
          }
        }
      }
    },
    "active": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_id",
        "carrier",
        "contributors",
        "identities",
        "carrier_origin_distance",
        "seed_cut",
        "seed_signals",
        "map_reference_id",
        "motion"
      ],
      "properties": {
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "carrier": {
          "type": "string",
          "pattern": "^support-actor-[0-9a-f]{20}$"
        },
        "contributors": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^support-actor-[0-9a-f]{20}$"
          }
        },
        "identities": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "side",
                  "pawn_handle",
                  "pawn_life",
                  "identity_status"
                ],
                "properties": {
                  "side": {
                    "enum": [
                      "T",
                      "CT"
                    ]
                  },
                  "pawn_handle": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "pawn_life": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "identity_status": {
                    "enum": [
                      "observed",
                      "unavailable",
                      "pawn_reference_unresolved"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "carrier_origin_distance": {
          "type": "number",
          "minimum": 0
        },
        "seed_cut": {
          "$ref": "#/$defs/cut"
        },
        "seed_signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal"
          }
        },
        "map_reference_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "motion": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "away_seconds",
              "divergent_seconds"
            ],
            "properties": {
              "away_seconds": {
                "type": "number",
                "minimum": 0
              },
              "divergent_seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "destination",
        "destination_landmark_id",
        "status",
        "spatial_scope",
        "map_reference_id",
        "signals",
        "possible_functions",
        "statement",
        "support_origin_cut",
        "support_current_cut",
        "supporting_survivors"
      ],
      "properties": {
        "plan_id": {
          "const": "prepare_entry"
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "destination_landmark_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "compatible"
        },
        "spatial_scope": {
          "const": "development_landmark_not_verified_zone_or_route"
        },
        "map_reference_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal"
          }
        },
        "possible_functions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "actor_alias",
              "function",
              "status",
              "signal_indices"
            ],
            "properties": {
              "actor_alias": {
                "type": "string",
                "pattern": "^support-actor-[0-9a-f]{20}$"
              },
              "function": {
                "enum": [
                  "c4_carrier",
                  "possible_utility_preparation"
                ]
              },
              "status": {
                "enum": [
                  "observed",
                  "compatible"
                ]
              },
              "signal_indices": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "support_origin_cut": {
          "$ref": "#/$defs/cut"
        },
        "support_current_cut": {
          "$ref": "#/$defs/cut"
        },
        "supporting_survivors": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^support-actor-[0-9a-f]{20}$"
          }
        }
      }
    }
  }
}

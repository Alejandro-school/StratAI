{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stratai.support_preparation_c4_cut@1",
  "x-stratai-training-authorized": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "cut",
    "provenance",
    "actors",
    "candidates"
  ],
  "properties": {
    "schema_id": {
      "const": "stratai.support_preparation_c4_cut@1"
    },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "frame",
        "tick",
        "epoch",
        "instance",
        "tick_rate",
        "sample_step"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "frame": {
          "type": "integer",
          "minimum": 1
        },
        "tick": {
          "type": "integer"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "instance": {
          "type": "integer",
          "minimum": 0
        },
        "tick_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "sample_step": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "provenance": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_sequence",
            "state_sequence",
            "objective_order",
            "first_cut"
          ],
          "properties": {
            "source_sequence": {
              "type": "integer",
              "minimum": 1
            },
            "state_sequence": {
              "type": "integer",
              "minimum": 1
            },
            "objective_order": {
              "type": "integer",
              "minimum": 1
            },
            "first_cut": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor_alias",
          "side",
          "pawn_handle",
          "pawn_life",
          "native_player",
          "initial"
        ],
        "properties": {
          "actor_alias": {
            "type": "string",
            "pattern": "^support-actor-[0-9a-f]{20}$"
          },
          "side": {
            "enum": [
              "CT",
              "T"
            ]
          },
          "pawn_handle": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "pawn_life": {
            "type": "string",
            "pattern": "^support-pawn-[0-9]{6,}$"
          },
          "native_player": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "actor_alias",
                  "pawn_life",
                  "pawn_handle",
                  "inventory_status",
                  "inventory_length",
                  "slots"
                ],
                "properties": {
                  "actor_alias": {
                    "type": "string",
                    "pattern": "^support-actor-[a-f0-9]{20}$"
                  },
                  "pawn_life": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^support-pawn-[0-9]{6,}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "pawn_handle": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "inventory_status": {
                    "enum": [
                      "pawn_unavailable",
                      "absent",
                      "unsupported_type",
                      "outside_probe",
                      "observed"
                    ]
                  },
                  "inventory_length": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "slots": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "status",
                        "handle",
                        "target_life"
                      ],
                      "properties": {
                        "status": {
                          "enum": [
                            "resolved",
                            "absent",
                            "unsupported_type",
                            "invalid_sentinel",
                            "entity_unavailable",
                            "serial_mismatch",
                            "kind_or_life_unavailable",
                            "destroyed"
                          ]
                        },
                        "handle": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 4294967295
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "target_life": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^support-item-[0-9]{6,}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "initial": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "has_c4",
              "carrier_player_position",
              "physical_c4_position"
            ],
            "properties": {
              "has_c4": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "observed"
                      },
                      "value": {
                        "type": "boolean"
                      },
                      "reason": {
                        "const": null
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "unavailable",
                          "not_applicable"
                        ]
                      },
                      "value": {
                        "const": null
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              },
              "carrier_player_position": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "observed"
                      },
                      "value": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "x",
                          "y",
                          "z"
                        ],
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          },
                          "z": {
                            "type": "number"
                          }
                        }
                      },
                      "reason": {
                        "const": null
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "unavailable",
                          "not_applicable"
                        ]
                      },
                      "value": {
                        "const": null
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              },
              "physical_c4_position": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "observed"
                      },
                      "value": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "x",
                          "y",
                          "z"
                        ],
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          },
                          "z": {
                            "type": "number"
                          }
                        }
                      },
                      "reason": {
                        "const": null
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "unavailable",
                          "not_applicable"
                        ]
                      },
                      "value": {
                        "const": null
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "actor_alias",
          "ally_alias"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^support-preparation-[0-9a-f]{64}$"
          },
          "actor_alias": {
            "type": "string",
            "pattern": "^support-actor-[0-9a-f]{20}$"
          },
          "ally_alias": {
            "type": "string",
            "pattern": "^support-actor-[0-9a-f]{20}$"
          }
        }
      }
    }
  }
}

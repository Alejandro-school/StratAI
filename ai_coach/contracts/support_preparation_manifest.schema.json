  "$defs": {
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "frame",
        "tick",
        "epoch",
        "instance",
        "tick_rate",
        "sample_step"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "frame": {
          "type": "integer",
          "minimum": 1
        },
        "tick": {
          "type": "integer"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "instance": {
          "type": "integer",
          "minimum": 0
        },
        "tick_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "sample_step": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "alive",
        "availability_tick",
        "availability_frame"
      ],
      "properties": {
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "alive": {
          "const": true
        },
        "availability_tick": {
          "type": "integer"
        },
        "availability_frame": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "end_tick",
        "availability_sequence",
        "availability_frame",
        "availability_tick",
        "sampled_displacement"
      ],
      "properties": {
        "status": {
          "enum": [
            "sampled_displacement",
            "no_sampled_displacement",
            "censored:missing_exact_horizon_sample",
            "censored:horizon_gap_or_boundary",
            "censored:identity_unavailable_or_changed",
            "censored:ambiguous_actor_alias",
            "censored:shared_pawn_reference",
            "censored:unsupported_side",
            "censored:disconnected",
            "censored:native_identity_unavailable",
            "censored:alive_unavailable",
            "censored:not_alive",
            "censored:position_unavailable"
          ]
        },
        "end_tick": {
          "type": "integer"
        },
        "availability_sequence": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "availability_frame": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "availability_tick": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "sampled_displacement": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "sampled_displacement"
              }
            }
          },
          "then": {
            "properties": {
              "sampled_displacement": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "no_sampled_displacement"
              }
            }
          },
          "then": {
            "properties": {
              "sampled_displacement": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "pattern": "^censored:"
              }
            }
          },
          "then": {
            "properties": {
              "sampled_displacement": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "censored:missing_exact_horizon_sample"
              }
            }
          },
          "then": {
            "properties": {
              "availability_sequence": {
                "const": null
              },
              "availability_frame": {
                "const": null
              },
              "availability_tick": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "censored:missing_exact_horizon_sample"
                }
              }
            }
          },
          "then": {
            "properties": {
              "availability_sequence": {
                "type": "integer",
                "minimum": 1
              },
              "availability_frame": {
                "type": "integer",
                "minimum": 1
              },
              "availability_tick": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stratai.economy_rule_context_assessment@1",
  "x-stratai-training-authorized": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "contract_version",
    "source_alias",
    "source_sha256",
    "build_identifier",
    "comparison_allowed",
    "training_allowed",
    "product_supported",
    "source_bindings",
    "package_sha256",
    "identity",
    "configuration_checks",
    "native_property_checks",
    "sessions",
    "armor_snapshot_groups",
    "summary"
  ],
  "properties": {
    "schema_id": {
      "const": "stratai.economy_rule_context_assessment@1"
    },
    "contract_version": {
      "const": "1.0.0-candidate.1"
    },
    "source_alias": {
      "type": "string",
      "pattern": "^demo-[a-f0-9]{20}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "build_identifier": {
      "type": "string",
      "minLength": 1
    },
    "comparison_allowed": {
      "const": false
    },
    "training_allowed": {
      "const": false
    },
    "product_supported": {
      "const": false
    },
    "source_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_manifest_sha256",
        "context_data_sha256",
        "source_manifest_sha256",
        "source_data_sha256",
        "source_candidate_manifest_sha256"
      ],
      "properties": {
        "context_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_data_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_data_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_candidate_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native",
        "candidate_revisions",
        "lookup_status",
        "lookup_method",
        "build_binding",
        "compatible_for_comparison"
      ],
      "properties": {
        "native": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "build_num",
            "patch_version",
            "network_protocol"
          ],
          "properties": {
            "build_num": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "value",
                "observed_values"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "observed",
                    "unavailable",
                    "conflicting"
                  ]
                },
                "value": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "observed_values": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "patch_version": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "value",
                "observed_values"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "observed",
                    "unavailable",
                    "conflicting"
                  ]
                },
                "value": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "observed_values": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "network_protocol": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "value",
                "observed_values"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "observed",
                    "unavailable",
                    "conflicting"
                  ]
                },
                "value": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "observed_values": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "candidate_revisions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        },
        "lookup_status": {
          "enum": [
            "native_identity_conflicting",
            "native_patch_unavailable",
            "patch_label_candidates_only",
            "no_patch_label_candidate"
          ]
        },
        "lookup_method": {
          "const": "remove_patch_label_dots_diagnostic_only_not_build_equivalence"
        },
        "build_binding": {
          "const": "unverified"
        },
        "compatible_for_comparison": {
          "const": false
        }
      }
    },
    "configuration_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "tick",
          "instance",
          "phase",
          "name",
          "value",
          "source_sequence",
          "source_tick",
          "status",
          "reference_values",
          "comparison"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "tick": {
            "type": "integer"
          },
          "instance": {
            "type": "integer",
            "minimum": 1
          },
          "phase": {
            "enum": [
              "round_start_probe",
              "freeze_end_probe"
            ]
          },
          "name": {
            "enum": [
              "ammo_grenade_limit_default",
              "ammo_grenade_limit_flashbang",
              "ammo_grenade_limit_total",
              "cash_player_bomb_defused",
              "cash_player_bomb_planted",
              "cash_player_damage_hostage",
              "cash_player_interact_with_hostage",
              "cash_player_killed_enemy_default",
              "cash_player_killed_enemy_factor",
              "cash_player_killed_hostage",
              "cash_player_killed_teammate",
              "cash_player_rescued_hostage",
              "cash_team_bonus_shorthanded",
              "cash_team_elimination_bomb_map",
              "cash_team_elimination_hostage_map_ct",
              "cash_team_elimination_hostage_map_t",
              "cash_team_hostage_alive",
              "cash_team_hostage_interaction",
              "cash_team_loser_bonus",
              "cash_team_loser_bonus_consecutive_rounds",
              "cash_team_planted_bomb_but_defused",
              "cash_team_rescued_hostage",
              "cash_team_terrorist_win_bomb",
              "cash_team_win_by_defusing_bomb",
              "cash_team_win_by_hostage_rescue",
              "cash_team_win_by_time_running_out_bomb",
              "cash_team_win_by_time_running_out_hostage",
              "mp_afterroundmoney",
              "mp_buy_allow_grenades",
              "mp_buy_anywhere",
              "mp_buy_during_immunity",
              "mp_buytime",
              "mp_consecutive_loss_aversion",
              "mp_consecutive_loss_max",
              "mp_death_drop_defuser",
              "mp_death_drop_grenade",
              "mp_death_drop_gun",
              "mp_defuser_allocation",
              "mp_free_armor",
              "mp_freezetime",
              "mp_maxmoney",
              "mp_maxrounds",
              "mp_overtime_enable",
              "mp_overtime_maxrounds",
              "mp_overtime_startmoney",
              "mp_playercashawards",
              "mp_starting_losses",
              "mp_startmoney",
              "mp_teamcashawards",
              "mp_weapons_allow_heavy",
              "mp_weapons_allow_map_placed",
              "mp_weapons_allow_pistols",
              "mp_weapons_allow_rifles",
              "mp_weapons_allow_smgs",
              "mp_weapons_allow_zeus",
              "sv_buy_status_override"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "source_sequence": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "source_tick": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "not_seen_in_probed_message_prefix",
              "source_tick_after_boundary",
              "native_value_absent",
              "native_value_unsupported",
              "observed_native_parameter"
            ]
          },
          "reference_values": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            }
          },
          "comparison": {
            "enum": [
              "unavailable",
              "conflicting_references",
              "equal_reference",
              "different_reference"
            ]
          }
        }
      }
    },
    "native_property_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instance",
          "phase",
          "tick",
          "name",
          "fact"
        ],
        "properties": {
          "instance": {
            "type": "integer",
            "minimum": 1
          },
          "phase": {
            "enum": [
              "round_start_probe",
              "freeze_end_probe"
            ]
          },
          "tick": {
            "type": "integer"
          },
          "name": {
            "enum": [
              "m_pGameRules.m_iNumConsecutiveCTLoses",
              "m_pGameRules.m_iNumConsecutiveTerroristLoses",
              "m_pGameRules.m_bCTCantBuy",
              "m_pGameRules.m_bTCantBuy"
            ]
          },
          "fact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "status",
              "source",
              "observation_tick",
              "availability_tick"
            ],
            "properties": {
              "value": {
                "type": [
                  "integer",
                  "boolean",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "observed",
                  "unavailable"
                ]
              },
              "source": {
                "type": "string",
                "maxLength": 256
              },
              "observation_tick": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "availability_tick": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "tick",
          "configuration_present",
          "manifest",
          "configuration_data"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "tick": {
            "type": "integer"
          },
          "configuration_present": {
            "type": "boolean"
          },
          "manifest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "present",
              "bytes",
              "sha256"
            ],
            "properties": {
              "present": {
                "type": "boolean"
              },
              "bytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "configuration_data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "present",
              "bytes",
              "sha256"
            ],
            "properties": {
              "present": {
                "type": "boolean"
              },
              "bytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "armor_snapshot_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_definition_index",
          "recorded_cost",
          "previous_armor_native",
          "previous_helmet_native",
          "snapshot_occurrences"
        ],
        "properties": {
          "item_definition_index": {
            "enum": [
              50,
              51
            ]
          },
          "recorded_cost": {
            "type": "integer",
            "minimum": 0
          },
          "previous_armor_native": {
            "type": "integer"
          },
          "previous_helmet_native": {
            "type": "boolean"
          },
          "snapshot_occurrences": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_checks",
        "native_property_checks",
        "observed_parameters",
        "observed_properties",
        "approved_rule_packages"
      ],
      "properties": {
        "configuration_checks": {
          "type": "integer",
          "minimum": 0
        },
        "native_property_checks": {
          "type": "integer",
          "minimum": 0
        },
        "observed_parameters": {
          "type": "integer",
          "minimum": 0
        },
        "observed_properties": {
          "type": "integer",
          "minimum": 0
        },
        "approved_rule_packages": {
          "const": 0
        }
      }
    }
  }
}

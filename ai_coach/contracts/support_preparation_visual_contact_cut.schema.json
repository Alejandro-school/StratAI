{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stratai.support_preparation_visual_contact_cut@1",
  "x-stratai-training-authorized": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "cut",
    "provenance",
    "actors",
    "candidates"
  ],
  "properties": {
    "schema_id": {
      "const": "stratai.support_preparation_visual_contact_cut@1"
    },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "frame",
        "tick",
        "epoch",
        "instance",
        "tick_rate",
        "sample_step"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "frame": {
          "type": "integer",
          "minimum": 1
        },
        "tick": {
          "type": "integer"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "instance": {
          "type": "integer",
          "minimum": 0
        },
        "tick_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "sample_step": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "provenance": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_sequence",
            "clock_order",
            "state_sequence",
            "delivery_sequence"
          ],
          "properties": {
            "source_sequence": {
              "type": "integer",
              "minimum": 1
            },
            "clock_order": {
              "type": "integer",
              "minimum": 1
            },
            "state_sequence": {
              "type": "integer",
              "minimum": 0
            },
            "delivery_sequence": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor_alias",
          "side",
          "pawn_handle",
          "pawn_life",
          "initial",
          "visual_reference"
        ],
        "properties": {
          "actor_alias": {
            "type": "string",
            "pattern": "^support-actor-[0-9a-f]{20}$"
          },
          "side": {
            "enum": [
              "CT",
              "T"
            ]
          },
          "pawn_handle": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "pawn_life": {
            "type": "string",
            "pattern": "^support-pawn-[0-9]{6,}$"
          },
          "initial": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "native_eye_offset",
              "reference_fov_degrees",
              "flash_clear",
              "smoke_clear",
              "visual_contact"
            ],
            "properties": {
              "native_eye_offset": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "observed"
                      },
                      "value": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "x",
                          "y",
                          "z"
                        ],
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          },
                          "z": {
                            "type": "number"
                          }
                        }
                      },
                      "reason": {
                        "type": "null"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "unavailable"
                      },
                      "value": {
                        "type": "null"
                      },
                      "reason": {
                        "enum": [
                          "native_eye_offset_unavailable",
                          "native_visual_c0_actor_continuity_unaccredited"
                        ]
                      }
                    }
                  }
                ]
              },
              "reference_fov_degrees": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "observed"
                      },
                      "value": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "exclusiveMaximum": 180
                      },
                      "reason": {
                        "type": "null"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "unavailable"
                      },
                      "value": {
                        "type": "null"
                      },
                      "reason": {
                        "enum": [
                          "native_camera_fov_unavailable",
                          "native_camera_fov_default_or_range_unaccredited",
                          "native_camera_fov_transition_unaccredited",
                          "scoped_optics_or_scope_state_unaccredited",
                          "native_visual_c0_actor_continuity_unaccredited"
                        ]
                      }
                    }
                  }
                ]
              },
              "flash_clear": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "unavailable"
                      },
                      "value": {
                        "type": "null"
                      },
                      "reason": {
                        "enum": [
                          "rendered_flash_opacity_unaccredited"
                        ]
                      }
                    }
                  }
                ]
              },
              "smoke_clear": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "unavailable"
                      },
                      "value": {
                        "type": "null"
                      },
                      "reason": {
                        "enum": [
                          "smoke_volume_and_coverage_unaccredited"
                        ]
                      }
                    }
                  }
                ]
              },
              "visual_contact": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "unavailable"
                      },
                      "value": {
                        "type": "null"
                      },
                      "reason": {
                        "enum": [
                          "legal_visual_contact_inputs_unaccredited"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          },
          "visual_reference": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_sequence",
                  "frame",
                  "state_sequence",
                  "pawn_life"
                ],
                "properties": {
                  "source_sequence": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "frame": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "state_sequence": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "pawn_life": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^support-pawn-[0-9]{6}$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "actor_alias",
          "ally_alias"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^support-preparation-[0-9a-f]{64}$"
          },
          "actor_alias": {
            "type": "string",
            "pattern": "^support-actor-[0-9a-f]{20}$"
          },
          "ally_alias": {
            "type": "string",
            "pattern": "^support-actor-[0-9a-f]{20}$"
          }
        }
      }
    }
  }
}

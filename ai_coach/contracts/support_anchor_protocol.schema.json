  "properties": {
    "schema_id": {
      "const": "stratai.support_anchor_protocol@1"
    },
    "contract_version": {
      "const": "1.0.0-candidate.1"
    },
    "scope": {
      "const": "factual_support_research_only"
    },
    "capability_reference": {
      "const": "CAP-TEAM-001"
    },
    "decision_id": {
      "const": null
    },
    "selection": {
      "const": "sampled_pair_separation_increase_onset"
    },
    "unit": {
      "const": "directed_actor_ally_instance"
    },
    "history_samples": {
      "const": 3
    },
    "nominal_sample_hz": {

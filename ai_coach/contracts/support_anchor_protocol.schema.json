    "contract_version",
    "scope",
    "capability_reference",
    "decision_id",
    "selection",
    "unit",
    "history_samples",
    "nominal_sample_hz",
    "history_rule",
    "selection_equation",
    "threshold_semantics",
    "t0",
    "deduplication",
    "future_window_seconds",
    "future_rule",
    "legal_features",
    "future_and_oracle_used_for_selection",
    "physical_entry_accredited",
    "comparison_allowed",
    "training_allowed",
    "product_supported"

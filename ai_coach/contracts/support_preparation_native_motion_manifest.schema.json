{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stratai.support_preparation_native_motion_manifest@1",
  "x-stratai-training-authorized": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "contract_version",
    "source_alias",
    "source_sha256",
    "build_identifier",
    "comparison_allowed",
    "training_allowed",
    "product_supported",
    "decision_eligible",
    "physical_entry_status",
    "tactical_commitment_status",
    "references",
    "artifact",
    "coverage"
  ],
  "properties": {
    "schema_id": {
      "const": "stratai.support_preparation_native_motion_manifest@1"
    },
    "contract_version": {
      "const": "1.0.0-candidate.1"
    },
    "source_alias": {
      "type": "string",
      "pattern": "^demo-[0-9a-f]{20}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_identifier": {
      "type": "string",
      "minLength": 1
    },
    "comparison_allowed": {
      "const": false
    },
    "training_allowed": {
      "const": false
    },
    "product_supported": {
      "const": false
    },
    "decision_eligible": {
      "const": false
    },
    "physical_entry_status": {
      "const": "not_accredited"
    },
    "tactical_commitment_status": {
      "const": "not_accredited"
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_source",
        "support_source",
        "preparation_protocol",
        "c4_source",
        "clock_source",
        "attempt_source",
        "position_source",
        "motion_source"
      ],
      "properties": {
        "objective_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "support_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "preparation_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "c4_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "clock_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "attempt_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "position_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "motion_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "records"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "support_preparation_native_motion_cuts.jsonl"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counts",
        "matrix"
      ],
      "properties": {
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cuts",
            "actor_cuts",
            "candidates"
          ],
          "properties": {
            "cuts": {
              "type": "integer",
              "minimum": 0
            },
            "actor_cuts": {
              "type": "integer",
              "minimum": 0
            },
            "candidates": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "actor_alias",
              "ally_alias",
              "side",
              "instance",
              "epoch",
              "candidates",
              "both_available",
              "fact_status_counts"
            ],
            "properties": {
              "actor_alias": {
                "type": "string",
                "pattern": "^support-actor-[0-9a-f]{20}$"
              },
              "ally_alias": {
                "type": "string",
                "pattern": "^support-actor-[0-9a-f]{20}$"
              },
              "side": {
                "enum": [
                  "CT",
                  "T"
                ]
              },
              "instance": {
                "type": "integer",
                "minimum": 0
              },
              "epoch": {
                "type": "integer",
                "minimum": 0
              },
              "candidates": {
                "type": "integer",
                "minimum": 0
              },
              "both_available": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "native_velocity",
                  "native_horizontal_speed",
                  "native_speed",
                  "ground_contact",
                  "ground_reference_state",
                  "movement_mode_code"
                ],
                "properties": {
                  "native_velocity": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "native_horizontal_speed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "native_speed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "ground_contact": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "ground_reference_state": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "movement_mode_code": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "fact_status_counts": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "self.native_velocity",
                  "self.native_horizontal_speed",
                  "self.native_speed",
                  "self.ground_contact",
                  "self.ground_reference_state",
                  "self.movement_mode_code",
                  "ally.native_velocity",
                  "ally.native_horizontal_speed",
                  "ally.native_speed",
                  "ally.ground_contact",
                  "ally.ground_reference_state",
                  "ally.movement_mode_code"
                ],
                "properties": {
                  "self.native_velocity": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^(observed|unavailable|not_applicable):[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "self.native_horizontal_speed": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^(observed|unavailable|not_applicable):[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "self.native_speed": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^(observed|unavailable|not_applicable):[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "self.ground_contact": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^(observed|unavailable|not_applicable):[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "self.ground_reference_state": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^(observed|unavailable|not_applicable):[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "self.movement_mode_code": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^(observed|unavailable|not_applicable):[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "ally.native_velocity": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^(observed|unavailable|not_applicable):[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "ally.native_horizontal_speed": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^(observed|unavailable|not_applicable):[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "ally.native_speed": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^(observed|unavailable|not_applicable):[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "ally.ground_contact": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^(observed|unavailable|not_applicable):[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "ally.ground_reference_state": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^(observed|unavailable|not_applicable):[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "ally.movement_mode_code": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^(observed|unavailable|not_applicable):[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

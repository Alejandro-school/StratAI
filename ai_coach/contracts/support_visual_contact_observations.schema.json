                  "m_pCameraServices.m_iFOVStart",
                  "m_pCameraServices.m_flFOVTime",
                  "m_pCameraServices.m_flFOVRate",
                  "m_flFlashDuration",
                  "m_flFlashMaxAlpha",
                  "m_bIsScoped"

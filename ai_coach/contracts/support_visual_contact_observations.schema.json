  "$defs": {
    "scalar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "native_type",
        "declared_type",
        "value"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "absent",
            "unsupported_type",
            "nonfinite"
          ]
        },
        "native_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "declared_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": [
                "number",
                "boolean",
                "null"
              ]
            },
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          ]
        }

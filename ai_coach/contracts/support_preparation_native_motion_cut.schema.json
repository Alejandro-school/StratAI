          "motion_reference": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state_sequence",
                  "entity_life",
                  "pawn_life",
                  "source_sequence",
                  "frame"
                ],
                "properties": {
                  "state_sequence": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "entity_life": {
                    "type": "string",
                    "pattern": "^support-motion-pawn-[0-9]{6}$"
                  },
                  "pawn_life": {
                    "type": "string",
                    "pattern": "^support-pawn-[0-9]{6}$"
                  },
                  "source_sequence": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "frame": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "actor_alias",
          "ally_alias"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^support-preparation-[0-9a-f]{64}$"
          },
          "actor_alias": {
            "type": "string",
            "pattern": "^support-actor-[0-9a-f]{20}$"
          },
          "ally_alias": {
            "type": "string",
            "pattern": "^support-actor-[0-9a-f]{20}$"
          }
        }
      }
    }
  }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stratai.support_preparation_native_motion_cut@1",
  "x-stratai-training-authorized": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "cut",
    "provenance",
    "actors",
    "candidates"
  ],
  "properties": {
    "schema_id": {
      "const": "stratai.support_preparation_native_motion_cut@1"
    },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "frame",
        "tick",
        "epoch",
        "instance",
        "tick_rate",
        "sample_step"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "frame": {
          "type": "integer",
          "minimum": 1
        },
        "tick": {
          "type": "integer"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "instance": {
          "type": "integer",
          "minimum": 0
        },
        "tick_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "sample_step": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "provenance": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_sequence",
            "clock_order",
            "state_sequence",
            "delivery_sequence"
          ],
          "properties": {
            "source_sequence": {
              "type": "integer",
              "minimum": 1
            },
            "clock_order": {
              "type": "integer",
              "minimum": 1
            },
            "state_sequence": {
              "type": "integer",
              "minimum": 0
            },
            "delivery_sequence": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor_alias",
          "side",
          "pawn_handle",
          "pawn_life",
          "initial",
          "motion_reference"
        ],
        "properties": {
          "actor_alias": {
            "type": "string",
            "pattern": "^support-actor-[0-9a-f]{20}$"
          },
          "side": {
            "enum": [
              "CT",
              "T"
            ]
          },
          "pawn_handle": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "pawn_life": {
            "type": "string",
            "pattern": "^support-pawn-[0-9]{6,}$"
          },
          "initial": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "native_velocity",
              "native_horizontal_speed",
              "native_speed",
              "ground_contact",
              "ground_reference_state",
              "movement_mode_code"
            ],
            "properties": {
              "native_velocity": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "observed"
                      },
                      "value": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "x",
                          "y",
                          "z"
                        ],
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          },
                          "z": {
                            "type": "number"
                          }
                        }
                      },
                      "reason": {
                        "const": null
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "unavailable",
                          "not_applicable"
                        ]
                      },
                      "value": {
                        "const": null
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              },
              "native_horizontal_speed": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "observed"
                      },
                      "value": {
                        "type": "number",
                        "minimum": 0
                      },
                      "reason": {
                        "const": null
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "unavailable",
                          "not_applicable"
                        ]
                      },
                      "value": {
                        "const": null
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              },
              "native_speed": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "observed"
                      },
                      "value": {
                        "type": "number",
                        "minimum": 0
                      },
                      "reason": {
                        "const": null
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "unavailable",
                          "not_applicable"
                        ]
                      },
                      "value": {
                        "const": null
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              },
              "ground_contact": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "observed"
                      },
                      "value": {
                        "type": "boolean"
                      },
                      "reason": {
                        "const": null
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "unavailable",
                          "not_applicable"
                        ]
                      },
                      "value": {
                        "const": null
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              },
              "ground_reference_state": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "observed"
                      },
                      "value": {
                        "enum": [
                          "none",
                          "world",
                          "entity"
                        ]
                      },
                      "reason": {
                        "const": null
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "unavailable",
                          "not_applicable"
                        ]
                      },
                      "value": {
                        "const": null
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              },
              "movement_mode_code": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "const": "observed"
                      },
                      "value": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "reason": {
                        "const": null
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "value",
                      "reason"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "unavailable",
                          "not_applicable"
                        ]
                      },
                      "value": {
                        "const": null
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stratai.spatial_participant_bridge@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "source_alias",
    "source_sha256",
    "map_id",
    "key_contract",
    "training_allowed",
    "participants"
  ],
  "properties": {
    "schema_id": {
      "const": "stratai.spatial_participant_bridge@1"
    },
    "source_alias": {
      "type": "string",
      "pattern": "^demo-[0-9a-f]{20}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "map_id": {
      "type": "string",
      "minLength": 1
    },
    "key_contract": {
      "const": "sha256(source_sha256 + LF + canonical_actor_id)@1"
    },
    "training_allowed": {
      "const": false
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor_key",
          "participant_alias"
        ],
        "properties": {
          "actor_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "participant_alias": {
            "type": "string",
            "pattern": "^participant-[0-9]{3}$"
          }
        }
      }
    }
  }
}

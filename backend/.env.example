# StratAI Backend Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env files with real secrets!

# REQUIRED: Steam Web API key (get from https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=your_steam_api_key_here

# REQUIRED: Session encryption key
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=generate_a_random_64_char_hex_string

# REQUIRED in production: independent service and credential secrets
INTERNAL_SERVICE_SECRET=generate_a_different_random_64_char_hex_string
CREDENTIAL_ENCRYPTION_KEY=generate_another_random_64_char_hex_string

# Environment: "development" or "production"
APP_ENV=development

# Session lifetime in seconds (default: 604800 = 7 days)
SESSION_MAX_AGE=604800

# Service connections
REDIS_URL=redis://localhost:6379
NODE_SERVICE_URL=http://localhost:4000
PUBLIC_BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1
PIPELINE_NAMESPACE=stratai:v2
PIPELINE_V2_ENABLED=true
GO_MAX_CONCURRENT_DEMOS=2
GO_ADMIN_ADDR=127.0.0.1:6060
ENABLE_PPROF=false
ALLOW_UNSIGNED_LOCAL_INTERNAL=false

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Optional HTTPS tunnel origin
# TUNNEL_ORIGIN=https://your-tunnel.trycloudflare.com

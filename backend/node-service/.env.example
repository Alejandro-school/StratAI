# StratAI Node.js Service Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env files with real secrets!

# REQUIRED: Steam bot account credentials
BOT_USERNAME=your_bot_username
BOT_PASSWORD=your_bot_password
BOT_SHARED_SECRET=your_shared_secret

# Optional: Multiple bot accounts (comma-separated)
# BOT_ACCOUNTS=user1:pass1:secret1,user2:pass2:secret2

# REQUIRED: Steam API Key (for cron job sharecode fetching)
STEAM_API_KEY=your_steam_api_key

# REQUIRED: Shared secret for HMAC service-to-service auth (must match Python SESSION_SECRET_KEY)
SESSION_SECRET_KEY=your_session_secret_key

# Redis connection
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT=10000
REDIS_MAX_RETRIES=50

# Server port
PORT=4000

# Service URLs
GO_SERVICE_URL=http://localhost:8080
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# Queue concurrency (tune for your hardware)
GC_CONCURRENCY=3
DOWNLOAD_CONCURRENCY=3
GO_CONCURRENCY=10

# Allowed CORS origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Cron job for automatic match detection
# CRON_INTERVAL=*/5 * * * *
# CRON_USER_DELAY=2000
# CRON_ENABLED=true

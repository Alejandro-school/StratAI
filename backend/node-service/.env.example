# StratAI Node.js Service Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env files with real secrets!

# REQUIRED: Steam bot account credentials
BOT_USERNAME=your_bot_username
BOT_PASSWORD=your_bot_password
BOT_SHARED_SECRET=your_shared_secret

# Optional: Multiple bot accounts (comma-separated)
# BOT_ACCOUNTS=user1:pass1:secret1,user2:pass2:secret2

# REQUIRED: Steam API Key (for scheduled history discovery)
STEAM_API_KEY=your_steam_api_key

# REQUIRED: independent HMAC and credential encryption secrets
INTERNAL_SERVICE_SECRET=your_internal_service_secret_at_least_32_chars
CREDENTIAL_ENCRYPTION_KEY=your_credential_encryption_secret_at_least_32_chars
PIPELINE_NAMESPACE=stratai:v2
PIPELINE_V2_ENABLED=true
ALLOW_UNSIGNED_LOCAL_INTERNAL=false

# Redis connection
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT=10000
REDIS_MAX_RETRIES=50

# Server port
PORT=4000

# Service URLs
GO_SERVICE_URL=http://localhost:8080

# Queue concurrency (tune for your hardware)
GC_CONCURRENCY=3
DOWNLOAD_CONCURRENCY=1
GO_CONCURRENCY=2
MIN_DEMO_BYTES=102400
MAX_DEMO_BYTES=1073741824
MIN_FREE_DISK_BYTES=2147483648
DEMO_CDN_ALLOWED_HOSTS=.steamcontent.com,.steamstatic.com,.akamaihd.net,.valve.net

# BullMQ scheduler for automatic match detection
# CRON_INTERVAL=*/5 * * * *
# CRON_ENABLED=true
